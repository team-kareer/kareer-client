{
  "extends": "@kareer/typescript-config/react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["vite/client", "vite-plugin-svgr/client"],
    "paths": {
      "@app/*": ["src/app/*"],
      "@pages/*": ["src/pages/*"],
      "@layout/*": ["src/layout/*"],
      "@sections/*": ["src/sections/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules"]
}
