{
  "extends": "@kareer/typescript-config/react.json",
  "compilerOptions": {
    "types": ["vite/client", "vite-plugin-svgr/client"],
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@constants/*": ["./src/constants/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@sections/*": ["./src/sections/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules"]
}
